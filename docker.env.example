# Copy to .env on the server. This file contains no real credentials.
FRAGELLA_API_KEY=
OPEN_METEO_API_KEY=
# Leave blank to generate a random signing key in the persistent data volume.
SILLAGE_SECRET_KEY=
# Use 1 when accessed through an HTTPS reverse proxy.
SILLAGE_SECURE_COOKIE=0
# Use 127.0.0.1 when the HTTPS proxy runs on the same server.
SILLAGE_BIND_ADDRESS=0.0.0.0
SILLAGE_PUBLIC_PORT=8000
SILLAGE_METADATA_TTL_DAYS=7
