# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SILLAGE_SECRET_KEY=
SILLAGE_HOST=127.0.0.1
SILLAGE_PORT=8000
# Set 1 behind HTTPS in production
SILLAGE_SECURE_COOKIE=0
# Optional commercial Open-Meteo subscription
OPEN_METEO_API_KEY=
# Primary catalog: fragella, fragdb, or sample (ten-record evaluation only).
# With a key configured, Fragella is selected automatically.
FRAGELLA_API_KEY=
SILLAGE_FRAGRANCE_PROVIDER=
# Directory with licensed fragrances.csv, notes.csv and accords.csv (pipe delimited)
SILLAGE_FRAGDB_PATH=
# Cached selected metadata expires for new lookups after this many days.
SILLAGE_METADATA_TTL_DAYS=7
